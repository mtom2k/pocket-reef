; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Pocket Reef"
config/description="A tiny aquarium that lives on your desktop."
config/version="0.6.0"
run/main_scene="res://scenes/main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="Pocket Reef"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/max_fps=0
run/low_processor_mode=true
run/low_processor_mode_sleep_usec=6900
boot_splash/show_image=false
boot_splash/bg_color=Color(0, 0, 0, 0)
config/icon="res://art/icons/app_icon.png"

[autoload]

TankState="*res://scripts/tank_state.gd"

[display]

window/size/viewport_width=192
window/size/viewport_height=120
window/size/window_width_override=576
window/size/window_height_override=360
window/size/resizable=false
window/size/borderless=true
window/size/always_on_top=true
window/size/transparent=true
window/per_pixel_transparency/allowed=true
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"
window/subwindows/embed_subwindows=false

[physics]

common/physics_ticks_per_second=10

[audio]

driver/mix_rate=22050

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
viewport/transparent_background=true
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
textures/vram_compression/import_etc2_astc=true
